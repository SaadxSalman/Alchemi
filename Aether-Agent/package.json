{
  "name": "aether-agent",
  "version": "1.0.0",
  "private": true,
  "description": "An AI agent designed to revolutionize humanitarian crisis response. Aether-Agent analyzes real-time satellite imagery, social media data, and news reports to detect natural disasters, predict the needs of affected communities, and coordinate a rapid and effective response.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:backend": "npm run dev --workspace=backend-node",
    "dev:web": "npm run dev --workspace=web",
    "dev": "concurrently -n backend,web -c blue,green \"npm run dev:backend\" \"npm run dev:web\"",
    "build:backend": "npm run build --workspace=backend-node",
    "build:web": "npm run build --workspace=web",
    "build:rust": "cargo build --release --manifest-path packages/rust-core/Cargo.toml",
    "start:backend": "npm run start --workspace=backend-node",
    "start:web": "npm run start --workspace=web"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saadsalmanakram/Aether-Agent.git"
  },
  "keywords": [
    "humanitarian",
    "ai-agent",
    "disaster-response",
    "solana",
    "rust",
    "nextjs"
  ],
  "author": "Saad Salman Akram",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/saadsalmanakram/Aether-Agent/issues"
  },
  "homepage": "https://github.com/saadsalmanakram/Aether-Agent#readme",
  "devDependencies": {
    "@types/node": "^25.0.3",
    "concurrently": "^9.1.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "mongoose": "^9.0.2",
    "zod": "^4.2.1"
  }
}