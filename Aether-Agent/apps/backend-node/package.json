{
  "name": "backend-node",
  "version": "1.0.0",
  "private": true,
  "description": "Aether-Agent Node.js orchestrator: Express + tRPC backend that routes between the Rust AI core, Milvus, MongoDB, and Solana.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@trpc/server": "^11.8.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "mongoose": "^9.0.2",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^25.0.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}