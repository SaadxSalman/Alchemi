import mongoose, { Schema, type InferSchemaType } from 'mongoose';

export const crisisSchema = new Schema(
  {
    type: {
      type: String,
      required: true,
      enum: [
        'Flood',
        'Wildfire',
        'Earthquake',
        'Hurricane',
        'Tsunami',
        'Drought',
        'Landslide',
        'Tornado',
        'Volcanic Eruption',
        'Unknown',
      ],
      index: true,
    },
    severity: {
      type: Number,
      required: true,
      min: 0,
      max: 1,
      default: 0.5,
    },
    crisisLabel: { type: String, required: true, default: 'Unknown' },
    location: {
      country: String,
      region: String,
      coordinates: {
        lat: Number,
        lng: Number,
      },
    },
    description: { type: String, default: '' },
    source: { type: String, default: 'manual' },
    imageUrl: String,
    reportCount: { type: Number, default: 0 },
    status: {
      type: String,
      enum: ['detected', 'monitoring', 'response-active', 'resolved'],
      default: 'detected',
      index: true,
    },
    active: { type: Boolean, default: true },
    solanaTx: String,
  },
  {
    timestamps: true,
  }
);

export type Crisis = InferSchemaType<typeof crisisSchema>;

export const CrisisModel =
  mongoose.models.Crisis ?? mongoose.model('Crisis', crisisSchema);