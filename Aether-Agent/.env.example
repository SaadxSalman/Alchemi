# ─── Aether-Agent Environment Variables ─────────────────────────────

# Node Backend (Express / tRPC)
PORT=4000
WEB_ORIGIN=http://localhost:3000

# MongoDB connection
MONGODB_URI=mongodb://localhost:27017/aether-agent

# Rust-Core (Axum) endpoint
RUST_CORE_URL=http://localhost:50051

# Milvus Vector Database — RESTful v2 API lives on the HTTP port (9091),
# NOT the gRPC port 19530.
MILVUS_URL=http://localhost:9091

# ─── Solana ──────────────────────────────────────────────────────────
SOLANA_RPC_URL=http://127.0.0.1:8899
SOLANA_PROGRAM_ID=G4sskGCCr4asC6Am8saezpvYJFhqR2aF79Q4625w3Pnd

# ─── Web (Next.js, consumed at build time) ───────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# ─── External API Keys (optional - used for real satellite ingestion) ─
# SENTINEL_HUB_API_KEY=
# GOOGLE_EARTH_ENGINE_API_KEY=
# NASA_GIBS_API_KEY=
# TWITTER_BEARER_TOKEN=