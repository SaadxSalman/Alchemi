# ════════════════════════════════════════════════════════════════
#  Alchemi — ENVIRONMENT TEMPLATE (safe to commit, no real secrets)
#  Copy this to venv/.env and fill in your real values.
# ════════════════════════════════════════════════════════════════

# ── LLM / Chemical Intelligence ─────────────────────────────────
# Your OpenAI API key enables LLM-powered agent reasoning.
# Leave empty → Alchemi runs fully offline with rule-based fallbacks.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── AI Engine ───────────────────────────────────────────────────
AI_ENGINE_HOST=0.0.0.0
AI_ENGINE_PORT=8000
AI_LOG_LEVEL=INFO
GATV2_CHECKPOINT=models/checkpoints/gatv2_multitask.pt

# ── Backend / Orchestration ─────────────────────────────────────
PORT=4000
NODE_ENV=development
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=<cluster>

# Alchemi API key — protects mutating endpoints (agent runs, molecule
# save/delete). The frontend sends it automatically via the x-api-key
# header. Leave empty in dev for open access; ALWAYS set in production.
# Generate one: python -c "import secrets; print(secrets.token_hex(32))"
ALCHEMI_API_KEY=

# ── Frontend ────────────────────────────────────────────────────
NEXT_PUBLIC_SERVER_URL=http://localhost:4000
NEXT_PUBLIC_APP_NAME=Alchemi
NEXT_PUBLIC_ALCHEMI_API_KEY=
